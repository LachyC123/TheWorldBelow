{
  "name": "the-world-below",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THE WORLD BELOW — browser pixel-art exploration survival shooter (iPhone Safari first).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools",
    "test": "vitest run",
    "validate:content": "vitest run tests/content.test.ts",
    "art": "node tools/art/build.ts",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
